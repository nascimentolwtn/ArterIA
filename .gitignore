# Claude Code agent worktrees (temporary, created by Agent tool isolation)
.claude/worktrees/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/

# ArterIA data policy (ADR 0004): large/raw/private data never lives in git.
# This is a safety net, not the only control — see the pre-commit hook.
cities/*/private/
**/raw/
*.fcd.xml
outputs/
.env

# Local ARTERIA_DATA (ADR 0014): downloaded/generated data, never committed
/data/

# Generated SUMO network artifacts (P0.6/ADR 0004): only patches/configs are versioned
cities/*/network/*.net.xml
cities/*/network/*.osm.xml
cities/*/network/*.rou.xml
cities/*/network/*.trips.xml
