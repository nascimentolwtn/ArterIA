<?xml version="1.0" encoding="UTF-8"?>
<!--
Hand-written toy SUMO net.xml for the general validity-checks module
(roadmap P5.4, arteria/interventions/validity.py). Not generated by
netconvert; just enough structure for the two checks the other fixtures
don't already give a standalone module: a junction with no touching edge
at all, and an edge whose every lane blocks pedestrians.

a0 -(edgeX)-> a1 -(edgeP)-> a2 -(edgeQ)-> a3 is one connected chain.
"lonely" has no edges at all, so it is unreachable from that chain.
edgeX's only lane carries neither allow nor disallow (unrestricted).
edgeP has two lanes that both block pedestrians (one disallow="pedestrian",
one allow="private"), so the edge as a whole is blocked. edgeQ's only lane
allows pedestrians explicitly, so it is not blocked.
-->
<net version="1.20" junctionCornerDetail="5">
    <location netOffset="0,0" convBoundary="0,0,300,0" origBoundary="-1,-1,-1,-1" projParameter="!"/>

    <edge id="edgeX" from="a0" to="a1" priority="1" numLanes="1" speed="13.89">
        <lane id="edgeX_0" index="0" speed="13.89" length="100.00" shape="0,0 100,0"/>
    </edge>
    <edge id="edgeP" from="a1" to="a2" priority="1" numLanes="2" speed="13.89">
        <lane id="edgeP_0" index="0" speed="13.89" length="100.00" shape="100,0 200,0" disallow="pedestrian"/>
        <lane id="edgeP_1" index="1" speed="13.89" length="100.00" shape="100,3 200,3" allow="private"/>
    </edge>
    <edge id="edgeQ" from="a2" to="a3" priority="1" numLanes="1" speed="13.89">
        <lane id="edgeQ_0" index="0" speed="13.89" length="100.00" shape="200,0 300,0" allow="pedestrian"/>
    </edge>

    <junction id="a0" type="dead_end" x="0" y="0" incLanes="" intLanes=""/>
    <junction id="a1" type="priority" x="100" y="0" incLanes="edgeX_0" intLanes=""/>
    <junction id="a2" type="priority" x="200" y="0" incLanes="edgeP_0 edgeP_1" intLanes=""/>
    <junction id="a3" type="dead_end" x="300" y="0" incLanes="edgeQ_0" intLanes=""/>
    <junction id="lonely" type="dead_end" x="0" y="100" incLanes="" intLanes=""/>

    <connection from="edgeX" to="edgeP" fromLane="0" toLane="0"/>
    <connection from="edgeP" to="edgeQ" fromLane="0" toLane="0"/>
</net>
