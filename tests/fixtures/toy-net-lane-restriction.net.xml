<?xml version="1.0" encoding="UTF-8"?>
<!--
Hand-written toy SUMO net.xml for lane vehicle-class restriction transform
tests (roadmap R18/P5.2). Not generated by netconvert; just enough
structure (one edge with two lanes) for the transform to operate on.

Lane W_0 starts with neither `allow` nor `disallow`. Lane W_1 starts with
an existing `disallow` attribute, to exercise the disallow-is-replaced
path.
-->
<net version="1.20" junctionCornerDetail="5">
    <location netOffset="0,0" convBoundary="0,0,100,0" origBoundary="-1,-1,-1,-1" projParameter="!"/>

    <edge id="W" from="w0" to="w1" priority="1" numLanes="2" speed="13.89">
        <lane id="W_0" index="0" speed="13.89" length="100.00" shape="0,0 100,0"/>
        <lane id="W_1" index="1" speed="13.89" length="100.00" shape="0,3 100,3" disallow="bicycle pedestrian"/>
    </edge>

    <junction id="w0" type="dead_end" x="0" y="0" incLanes="" intLanes=""/>
    <junction id="w1" type="dead_end" x="100" y="0" incLanes="W_0 W_1" intLanes=""/>
</net>
