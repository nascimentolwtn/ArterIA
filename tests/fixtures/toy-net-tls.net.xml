<?xml version="1.0" encoding="UTF-8"?>
<!--
Hand-written toy SUMO net.xml for the signal-retiming transform tests
(roadmap R18/P5.2). Not generated by netconvert; just enough structure
(one signalized junction with a 2-phase tlLogic, one unsignalized
junction) for the transform to operate on.
-->
<net version="1.20" junctionCornerDetail="5">
    <location netOffset="0,0" convBoundary="0,0,200,200" origBoundary="-1,-1,-1,-1" projParameter="!"/>

    <edge id="A" from="a0" to="j0" priority="1" numLanes="1" speed="13.89">
        <lane id="A_0" index="0" speed="13.89" length="100.00" shape="0,0 100,0"/>
    </edge>
    <edge id="B" from="j0" to="b0" priority="1" numLanes="1" speed="13.89">
        <lane id="B_0" index="0" speed="13.89" length="100.00" shape="100,0 200,0"/>
    </edge>

    <junction id="a0" type="dead_end" x="0" y="0" incLanes="" intLanes=""/>
    <junction id="j0" type="traffic_light" x="100" y="0" incLanes="A_0" intLanes=""/>
    <junction id="b0" type="dead_end" x="200" y="0" incLanes="B_0" intLanes=""/>

    <connection from="A" to="B" fromLane="0" toLane="0"/>

    <tlLogic id="tls0" type="static" programID="0" offset="0">
        <phase duration="31" state="Gr"/>
        <phase duration="5" state="yr"/>
    </tlLogic>
</net>
