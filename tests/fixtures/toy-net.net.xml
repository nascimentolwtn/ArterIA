<?xml version="1.0" encoding="UTF-8"?>
<!--
Hand-written toy SUMO net.xml for turn-restriction transform tests
(roadmap R18/P5.2). Not generated by netconvert; just enough structure
(edges, junctions, connections) for the transform and its connectivity
check to operate on.

Two independent scenarios live side by side:
- N -> M has both a direct connection and a bypass via S, so removing
  the direct connection leaves M reachable from N (still_connected).
- P -> Q has only one connection, so removing it leaves Q unreachable
  from P (not still_connected).
-->
<net version="1.20" junctionCornerDetail="5">
    <location netOffset="0,0" convBoundary="0,0,300,300" origBoundary="-1,-1,-1,-1" projParameter="!"/>

    <edge id="N" from="n0" to="n1" priority="1" numLanes="1" speed="13.89">
        <lane id="N_0" index="0" speed="13.89" length="100.00" shape="0,0 100,0"/>
    </edge>
    <edge id="M" from="n2" to="n3" priority="1" numLanes="1" speed="13.89">
        <lane id="M_0" index="0" speed="13.89" length="100.00" shape="200,0 300,0"/>
    </edge>
    <edge id="S" from="n1" to="n2" priority="1" numLanes="1" speed="13.89">
        <lane id="S_0" index="0" speed="13.89" length="100.00" shape="100,20 200,20"/>
    </edge>

    <edge id="P" from="p0" to="p1" priority="1" numLanes="1" speed="13.89">
        <lane id="P_0" index="0" speed="13.89" length="100.00" shape="0,-100 100,-100"/>
    </edge>
    <edge id="Q" from="p1" to="p3" priority="1" numLanes="1" speed="13.89">
        <lane id="Q_0" index="0" speed="13.89" length="100.00" shape="100,-100 200,-100"/>
    </edge>

    <junction id="n0" type="dead_end" x="0" y="0" incLanes="" intLanes=""/>
    <junction id="n1" type="priority" x="100" y="0" incLanes="N_0" intLanes=""/>
    <junction id="n2" type="priority" x="200" y="0" incLanes="S_0" intLanes=""/>
    <junction id="n3" type="dead_end" x="300" y="0" incLanes="M_0" intLanes=""/>

    <junction id="p0" type="dead_end" x="0" y="-100" incLanes="" intLanes=""/>
    <junction id="p1" type="priority" x="100" y="-100" incLanes="P_0" intLanes=""/>
    <junction id="p3" type="dead_end" x="200" y="-100" incLanes="Q_0" intLanes=""/>

    <connection from="N" to="M" fromLane="0" toLane="0"/>
    <connection from="N" to="S" fromLane="0" toLane="0"/>
    <connection from="S" to="M" fromLane="0" toLane="0"/>

    <connection from="P" to="Q" fromLane="0" toLane="0"/>
</net>
