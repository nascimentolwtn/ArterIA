<?xml version="1.0" encoding="UTF-8"?>
<!--
Hand-written toy SUMO net.xml for one-way-conversion transform tests
(roadmap R18/P5.2). Not generated by netconvert; just enough structure
(edges, junctions, connections) for the transform and its connectivity
check to operate on.

Two independent scenarios live side by side:
- j0/j1/j2 form a fully two-way triangle (each pair joined by a pair of
  opposite directional edges, e.g. "A"/"-A"). Removing one directional
  edge of a pair (e.g. "-A") still leaves every junction reachable via the
  other two sides of the triangle, so orphaned_junctions is empty.
- j3 is a dead-end side branch hanging off j1 through the single
  directional edge "D". Removing "D" leaves j3 with no touching edge at
  all, so it is orphaned.
-->
<net version="1.20" junctionCornerDetail="5">
    <location netOffset="0,0" convBoundary="0,0,300,300" origBoundary="-1,-1,-1,-1" projParameter="!"/>

    <edge id="A" from="j0" to="j1" priority="1" numLanes="1" speed="13.89">
        <lane id="A_0" index="0" speed="13.89" length="100.00" shape="0,0 100,0"/>
    </edge>
    <edge id="-A" from="j1" to="j0" priority="1" numLanes="1" speed="13.89">
        <lane id="-A_0" index="0" speed="13.89" length="100.00" shape="100,0 0,0"/>
    </edge>

    <edge id="B" from="j1" to="j2" priority="1" numLanes="1" speed="13.89">
        <lane id="B_0" index="0" speed="13.89" length="100.00" shape="100,0 100,100"/>
    </edge>
    <edge id="-B" from="j2" to="j1" priority="1" numLanes="1" speed="13.89">
        <lane id="-B_0" index="0" speed="13.89" length="100.00" shape="100,100 100,0"/>
    </edge>

    <edge id="C" from="j2" to="j0" priority="1" numLanes="1" speed="13.89">
        <lane id="C_0" index="0" speed="13.89" length="140.00" shape="100,100 0,0"/>
    </edge>
    <edge id="-C" from="j0" to="j2" priority="1" numLanes="1" speed="13.89">
        <lane id="-C_0" index="0" speed="13.89" length="140.00" shape="0,0 100,100"/>
    </edge>

    <edge id="D" from="j1" to="j3" priority="1" numLanes="1" speed="13.89">
        <lane id="D_0" index="0" speed="13.89" length="100.00" shape="100,0 200,0"/>
    </edge>

    <junction id="j0" type="priority" x="0" y="0" incLanes="-A_0 C_0" intLanes=""/>
    <junction id="j1" type="priority" x="100" y="0" incLanes="A_0 -B_0" intLanes=""/>
    <junction id="j2" type="priority" x="100" y="100" incLanes="B_0 -C_0" intLanes=""/>
    <junction id="j3" type="dead_end" x="200" y="0" incLanes="D_0" intLanes=""/>

    <connection from="A" to="B" fromLane="0" toLane="0"/>
    <connection from="B" to="C" fromLane="0" toLane="0"/>
    <connection from="C" to="-A" fromLane="0" toLane="0"/>
    <connection from="-A" to="-C" fromLane="0" toLane="0"/>
    <connection from="-C" to="-B" fromLane="0" toLane="0"/>
    <connection from="-B" to="A" fromLane="0" toLane="0"/>
    <connection from="A" to="D" fromLane="0" toLane="0"/>
</net>
